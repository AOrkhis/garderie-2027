PORT=3000
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=Garderie
DB_SYNCHRONIZE=true

JWT_SECRET=change-me
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

UPLOAD_DIR=uploads

# Courriels (séparés par des virgules) des comptes super administrateurs de la plateforme
SUPER_ADMIN_COURRIELS=

# Courriels : si SMTP_HOST est vide, les courriels sont affichés dans la console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Garderie 2027 <no-reply@garderie2027.ca>"
# Si défini, envoi via l'API HTTPS Brevo au lieu de SMTP (ports bloqués chez certains hébergeurs)
BREVO_API_KEY=

# Stripe (paiements des forfaits) — laisser vide pour désactiver la vente en ligne
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
